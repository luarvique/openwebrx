diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,8 +9,12 @@ set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall")
 include(CMakeDependentOption)
 
 add_executable(acarsdec acars.c  acarsdec.c  label.c  msk.c  output.c netout.c fileout.c lib.c statsd.c)
 execute_process(COMMAND git describe --tags --always --dirty OUTPUT_VARIABLE VERSION OUTPUT_STRIP_TRAILING_WHITESPACE)
-if(VERSION)
-add_compile_definitions(VERSION="${VERSION}")
+if(VERSION MATCHES "^v?[0-9]+\\.[0-9]+")
+  add_compile_definitions(VERSION="${VERSION}")
+else()
+  # A detached source build may have no reachable version tag and report
+  # only a commit hash. Keep the source tree's declared release version.
+  add_compile_definitions(VERSION="4.4.1")
 endif()
 
 find_package(PkgConfig)
